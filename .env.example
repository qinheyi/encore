# --- Qloo (taste data) ---
# Hackathon key from the Qloo Agentic Hackathon. Leave empty to run on MOCK data.
QLOO_API_KEY=
# Force mock data even when a key is present (1 = mock)
QLOO_MOCK=

# --- LLM agent ---
# OFF by default. Set to "minimax" or "stepfun" (and that provider's key) to enable;
# otherwise Encore uses rule-based reasons and still returns a full plan.
ENCORE_LLM=
# 1 = single structured call (cheapest). 2-4 = allow tool calls (get_city_playbook, estimate_route_km) first.
ENCORE_AGENT_MAX_STEPS=1
LLM_TIMEOUT_MS=110000

# MiniMax (China site, OpenAI-compatible)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MODEL=MiniMax-M3
# MiniMax-M3 runs with thinking disabled (faster/cheaper) unless this is "adaptive". M2.x models always think.
MINIMAX_THINKING=

# StepFun (OpenAI-compatible)
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/v1
STEPFUN_MODEL=step-3.5-flash
